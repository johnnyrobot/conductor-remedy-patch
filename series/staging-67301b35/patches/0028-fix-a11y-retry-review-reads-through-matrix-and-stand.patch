@@ -0,0 +1,8 @@
+import {test,expect,vi,afterEach} from 'vitest';
+import api from './api';
+afterEach(()=>vi.unstubAllGlobals());
+test('standalone capability request reaches the authenticated API without Platform initialization',async()=>{
+ const fetcher=vi.fn(async()=>({ok:true,json:async()=>({err:false,available:true,capabilities:{scan:true,preview:true,mutate:false,operation_status:false}})}));vi.stubGlobal('fetch',fetcher);
+ const result=await api.getProjectRemedyCapability('project123');expect(result.data.available).toBe(true);
+ expect(fetcher).toHaveBeenCalledWith('/api/v1/project/accessibility/remedy/health?projectID=project123',expect.objectContaining({credentials:'include',headers:{'X-Requested-With':'XMLHttpRequest'}}));
+});
diff --git a/client/src/api.ts b/client/src/api.ts
index 4bb96e86..5f917a87 100644
--- a/client/src/api.ts
+++ b/client/src/api.ts
@@ -154,8 +154,13 @@ export type ProjectRemedyCapability = ConductorBaseResponse & {
 };
 
 class API {
-  getProjectRemedyCapability(projectID: string) {
-    return axios.get<ProjectRemedyCapability>('/project/accessibility/remedy/health', {params: {projectID}});
+  async getProjectRemedyCapability(projectID: string) {
+    const response = await fetch(`${this.BASE_URL}/project/accessibility/remedy/health?projectID=${encodeURIComponent(projectID)}`, {
+      credentials: 'include', headers: {'X-Requested-With': 'XMLHttpRequest'},
+    });
+    const data: ProjectRemedyCapability = await response.json();
+    if (!response.ok || data.err) throw Error('Remedy availability could not be checked.');
+    return {data};
   }
 
   private readonly BASE_URL: string =
