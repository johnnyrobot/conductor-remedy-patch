+test("mounted degraded review-only matrix deliberately retries through its readiness helper",async()=>{
+  axios.get.mockReset(); axios.post.mockReset(); axios.put.mockReset();
+  const expired=false,evidenceChanged=false;
+  let fingerprint = 'source-A';
+  const finding = { id: 'finding1', fixable: true, message: 'Synthetic missing description', ruleId: 'img-alt', selector: 'img' };
+  const review = { criteria: [{ id: '1.1.1', title: 'Non-text Content', principle: 'Perceivable', status: 'fail', evidence: [finding] }], summary: { failCount: 1 } };
+  const section = { _id: 'section-1', pageID: '123', sectionTitle: 'Synthetic page', sectionURL: 'https://dev.libretexts.org/Sandboxes/johnnyphung/test', wcagReview: review };
+  const project = { projectID: 'fixture01', title: 'Fixture project', members: ['editor'], leads: [], liaisons: [], auditors: [], tags: [] };
+  axios.get.mockImplementation(async path => ({ data: path === '/project' ? { err: false, project }
+    : path.includes('remedy/health') ? { err: false, available: false, readRetry: true, profile:{contract:"cxone-review-v1",name:"review-only"}, capabilities: { scan: false, preview: true, mutate: false, operation_status:false } }
+    : { err: false, a11yReview: [section] } }));
+  axios.put.mockResolvedValue({ data: { err: false } });
+  axios.post.mockImplementation(async path => { if (path.endsWith('/preview') && evidenceChanged) fingerprint = null; return { data: path.endsWith('/scan') ? { err: false, findings: [finding], wcag_review: review }
+    : path.endsWith('/preview') ? { err: false, before_html: '<p>old</p>', after_html: '<p>new</p>', diff: '-old\n+new', preview_hash: 'hash', preview_token: 'remote-token', evidenceChanged, localReviewID: 'matrix-stored-review', review_expires_at: Math.floor(Date.now()/1000)+(expired ? -1 : 300) }
+    : { err: false, applied: false, outcome: 'not_attempted', reason: 'no_change' } }; });
+  const reviewerPage=()=>({sectionID:'page1',title:'Reviewer page',url:section.sectionURL,fingerprint,blockers:[],criteria:[{id:'1.1.1',title:'Non-text Content',status:'unreviewed',checklist:['Compare source images']}]});
+  vi.stubGlobal('fetch', vi.fn(async path => ({ ok: true, json: async () => path.includes('/conformance/pages/') ? (path.includes('/criteria/') ? {err:false,criterion:reviewerPage().criteria[0]} : {err:false,page:reviewerPage()}) : path.endsWith('/conformance')
+    ? { err: false, canEdit: true, report: { scope: { version: 'scope-1' }, pages: [{ sectionID: 'page1', title: 'Reviewer page', url: section.sectionURL, fingerprint, blockers: [], criteria: [{ id: '1.1.1', title: 'Non-text Content', status: 'unreviewed', checklist: ['Compare source images'] }] }], totalCriteria: 1, verifiedCriteria: 0, verificationPercent: 0, status: 'verification_pending', readyForSignoff: false } }
+    : { err: false, canEdit: true, items: [], users: [], sections: [], candidates: [] } })));
+  const container = document.createElement('div'); document.body.appendChild(container); const root = createRoot(container);
+  try {
+    await act(async () => root.render(<MemoryRouter><ProjectAccessibility match={{ params: { id: 'fixture01' } }} location={{ search: '' }} /></MemoryRouter>));
+    await act(async () => {});
+    if (evidenceChanged) {
+      fireEvent.change(await screen.findByLabelText('Page to evaluate'), { target: { value: 'page1' } });
+      fireEvent.click(await screen.findByLabelText('Compare source images'));
+      fireEvent.change(screen.getByLabelText(/Test environment/), { target: { value: 'Synthetic screen reader' } });
+      fireEvent.change(screen.getByLabelText(/Evidence and results/), { target: { value: 'Reviewed the original source images before preview.' } });
+      fireEvent.click(screen.getByLabelText(/I performed this review/));
+    }
+    const fix = (await screen.findAllByRole('button', { name: 'Fix 1' }))[0];
+    await act(async () => fireEvent.click(fix));
+    const preview = await screen.findByRole('button', { name: 'Preview changes' });
+    await act(async () => fireEvent.click(preview));
+    await waitFor(()=>expect(axios.post.mock.calls.some(([path])=>path.endsWith('/preview'))).toBe(true));
     expect(screen.queryByLabelText('I reviewed this preview and want to apply these changes.')).toBeNull();
     expect(screen.getByRole('button',{name:'Apply to LibreTexts'})).toBeDisabled();
     expect(container.textContent).toContain('normal book editor');
