+import React, { useState } from 'react';
+
+/** Explicit evidence lookup never retries a mutation or releases a pending claim. */
+export default function RemedyOperationStatus({ base, sectionID, localOperationID, request }: any) {
+  const [busy, setBusy] = useState(false), [message, setMessage] = useState('');
+  if (!localOperationID) return null;
+  async function lookup() {
+    setBusy(true);
+    try {
+      const data = await request(`${base}/page/${encodeURIComponent(sectionID)}/operations/${encodeURIComponent(localOperationID)}`, 'GET');
+      const state = data.operation?.outcome;
+      const labels: Record<string, string> = { pending: 'Still pending', not_attempted: 'No mutation attempted', known_success: 'Write confirmed', unknown_write: 'Write outcome unknown' };
+      setMessage(`${labels[state] || 'Outcome unavailable'}. ${data.pending ? 'The page remains blocked. An operator must reconcile it before further actions.' : 'This is saved operation evidence; it does not establish current accessibility verification.'}`);
+    } catch (error: any) { setMessage(`${error.message} Keep the page blocked; do not repeat the write.`); }
+    finally { setBusy(false); }
+  }
+  return <div className="ui message" aria-label="Write operation evidence">
+    <p>Inspect the saved operation after an interrupted or uncertain write. This check does not retry the write or unlock the page.</p>
+    <button type="button" className="ui button" disabled={busy} onClick={lookup}>Read operation evidence</button>
+    {message && <p role="status">{message}</p>}
+  </div>;
+}
