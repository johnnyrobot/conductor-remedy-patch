+    && value.evidence_effect === 'invalidate' && value.reason === 'write_outcome_unknown' && ((value.requires_reconciliation && value.reconciliation === 'required') || (!value.requires_reconciliation && value.reconciliation === 'resolved'))) {
+    return { metadata: value, effect: 'invalidate', terminal: false };
+  }
+  return null;
+}
+
+export function safeOperationMetadata(value: any) {
+  return Object.fromEntries(['operation_id', 'action', 'outcome', 'reason', 'applied', 'restored', 'audit_recorded', 'requires_reconciliation', 'reconciliation', 'evidence_effect', 'updated_at'].map(key => [key, value[key]]));
