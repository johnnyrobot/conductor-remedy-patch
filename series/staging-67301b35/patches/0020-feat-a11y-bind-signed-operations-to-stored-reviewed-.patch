+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createHash, createPrivateKey } from 'node:crypto';
+import { mkdtempSync, writeFileSync, rmSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import corpus from '../integration/fixtures/lt1-signer-vectors.json';
+import { signReviewedOperation, signingConfiguration } from './remedyReview.js';
+
+// Public deterministic forgeable fixture material. Never a production credential.
+const seed = createHash('sha256').update(corpus.public_test_seed_phrase).digest();
+const key = createPrivateKey({ key: Buffer.concat([Buffer.from('302e020100300506032b657004220420', 'hex'), seed]), type: 'pkcs8', format: 'der' });
+for (const vector of corpus.positive) test(`native Node22 signer matches frozen LT1 r2 bytes: ${vector.name}`, () => {
+  const payload = JSON.parse(Buffer.from(vector.payload_bytes_base64url, 'base64url').toString());
+  const result = signReviewedOperation({ key, kid: corpus.kid, issuer: payload.iss, audience: payload.aud,
+    notBefore: vector.context.key_policy.not_before, notAfter: vector.context.key_policy.not_after }, payload.binding,
+    payload.sub, vector.context.preview_expires_at, payload.iat, payload.jti);
+  assert.equal(result.assertion, vector.compact);
+});
+test('signer caps expiry to authoritative preview and local key window', () => {
+  const payload = JSON.parse(Buffer.from(corpus.positive[0].payload_bytes_base64url, 'base64url').toString());
+  const config = { key, kid: corpus.kid, issuer: payload.iss, audience: payload.aud, notBefore: payload.iat-60, notAfter: payload.iat+30 };
+  assert.equal(signReviewedOperation(config, payload.binding, payload.sub, payload.iat+20, payload.iat).exp, payload.iat+20);
+  assert.equal(signReviewedOperation(config, payload.binding, payload.sub, payload.iat+300, payload.iat).exp, payload.iat+30);
+  assert.throws(() => signReviewedOperation(config, payload.binding, payload.sub, payload.iat+1, payload.iat), /expired|expiry/);
+});
+test('production refuses the public fixture key even when renamed', () => {
+  const original = { ...process.env }, directory = mkdtempSync(join(tmpdir(), 'lt1-public-fixture-'));
+  try {
+    const path = join(directory, 'public-test.pem'); writeFileSync(path, key.export({ format: 'pem', type: 'pkcs8' }), { mode: 0o600 });
+    const now = Math.floor(Date.now()/1000);
+    Object.assign(process.env, { NODE_ENV: 'production', REMEDY_REVIEWER_KEY_ENABLED: 'true', REMEDY_REVIEWER_KEY_ID: 'renamed-public-fixture',
+      REMEDY_REVIEWER_ISSUER: 'urn:test', REMEDY_REVIEWER_AUDIENCE: 'urn:test', REMEDY_REVIEWER_SIGNING_KEY_FILE: path,
+      REMEDY_REVIEWER_KEY_NOT_BEFORE: String(now-10), REMEDY_REVIEWER_KEY_NOT_AFTER: String(now+300) });
+    assert.throws(() => signingConfiguration(), /unavailable/);
+  } finally { for (const name of Object.keys(process.env)) if (!(name in original)) delete process.env[name]; Object.assign(process.env, original); rmSync(directory, { recursive: true, force: true }); }
+});
