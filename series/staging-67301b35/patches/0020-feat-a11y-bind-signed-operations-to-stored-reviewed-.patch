+  expect(screen.getByRole('button', { name: 'Apply reviewed fix and rescan' })).toBeDisabled();
+  fireEvent.click(confirmation);
+  fireEvent.click(screen.getByRole('button', { name: 'Apply reviewed fix and rescan' }));
+  await screen.findByText(/Current evidence was preserved/);
+  const write = request.mock.calls.find(([path]) => path.endsWith('/apply'));
