+import { createHash, createPrivateKey, createPublicKey, randomBytes, sign, KeyObject } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+
+export const reviewError = (message: string, status = 409) => Object.assign(Error(message), { status, publicMessage: message });
+export const reviewSession = (session: unknown) => typeof session === 'string' && session.length ? createHash('sha256').update(session).digest('hex') : '';
+const hash = (text: string) => createHash('sha256').update(text, 'utf8').digest('hex');
+const exact = (value: any, keys: string[]) => value && typeof value === 'object' && !Array.isArray(value)
+  && Object.keys(value).length === keys.length && keys.every(key => Object.hasOwn(value, key));
+const digest = (value: unknown) => typeof value === 'string' && /^[a-f0-9]{64}$/.test(value);
+const ascii = (value: unknown, max: number) => typeof value === 'string' && value.length > 0 && value.length <= max && /^[\x21-\x7e]+$/.test(value);
+
+/** Validate the authoritative preview without rebuilding or normalizing its signed binding. */
+export function checkedPreview(result: any, section: any, action: string) {
+  const binding = result?.review_binding;
+  const expectedAction = action === 'restore-preview' ? 'cxone.restore' : 'cxone.apply';
+  if (!exact(binding, ['action', 'target', 'preview_token', 'before_sha256', 'after_sha256', 'fix_mode', 'tier', 'snapshot'])
+    || binding.action !== expectedAction
+    || !exact(binding.target, ['hostname', 'page_id', 'page_path'])
+    || binding.target.hostname !== new URL(section.sectionURL).hostname
+    || binding.target.page_id !== section.pageID
+    || !/^[1-9]\d*$/.test(binding.target.page_id) || !Number.isSafeInteger(Number(binding.target.page_id))
+    || typeof binding.target.page_path !== 'string' || binding.target.page_path.length > 4096
+    || !binding.target.page_path.startsWith('Sandboxes/johnnyphung/') || /[\\\x00-\x1f]/.test(binding.target.page_path)
+    || /[\uD800-\uDFFF]/u.test(binding.target.page_path) || binding.target.page_path.split('/').some((part: string) => part === '.' || part === '..')
+    || !ascii(binding.preview_token, 200) || binding.preview_token !== result.preview_token
+    || !digest(binding.before_sha256) || !digest(binding.after_sha256)
+    || typeof result.before_html !== 'string' || typeof result.after_html !== 'string'
+    || hash(result.before_html) !== binding.before_sha256 || hash(result.after_html) !== binding.after_sha256
+    || !Number.isSafeInteger(result.review_expires_at)) throw reviewError('Remedy did not return a valid authoritative reviewed preview.', 502);
+  if (expectedAction === 'cxone.restore') {
+    if (binding.fix_mode !== 'restore' || binding.tier !== null || !exact(binding.snapshot, ['timestamp', 'sha256'])
+      || typeof binding.snapshot.timestamp !== 'string' || !Number.isFinite(Date.parse(binding.snapshot.timestamp))
+      || binding.snapshot.sha256 !== binding.after_sha256) throw reviewError('Remedy did not return a valid restore binding.', 502);
+  } else if (!['deterministic', 'pipeline'].includes(binding.fix_mode) || binding.snapshot !== null
+    || (binding.fix_mode === 'deterministic' ? binding.tier !== null : !Number.isInteger(binding.tier) || binding.tier < 1 || binding.tier > 3)) {
+    throw reviewError('Remedy did not return a valid fix binding.', 502);
+  }
+  if (result.review_expires_at <= Math.floor(Date.now() / 1000) + 1) throw reviewError('This preview has expired. Generate and review a new preview.');
+  return binding;
+}
+
+export type SigningConfiguration = { key: KeyObject; kid: string; issuer: string; audience: string; notBefore: number; notAfter: number };
+/** Optional signer misconfiguration fails only mutation admission, never ordinary app startup. */
+export function signingConfiguration(now = Math.floor(Date.now() / 1000)): SigningConfiguration {
+  try {
+    const kid = process.env.REMEDY_REVIEWER_KEY_ID, issuer = process.env.REMEDY_REVIEWER_ISSUER, audience = process.env.REMEDY_REVIEWER_AUDIENCE;
+    const before = process.env.REMEDY_REVIEWER_KEY_NOT_BEFORE || '', after = process.env.REMEDY_REVIEWER_KEY_NOT_AFTER || '';
+    if (!/^\d+$/.test(before) || !/^\d+$/.test(after)) throw Error();
+    const notBefore = Number(before), notAfter = Number(after);
+    if (process.env.REMEDY_REVIEWER_KEY_ENABLED !== 'true' || !kid || !/^[A-Za-z0-9._-]{1,64}$/.test(kid)
+      || !ascii(issuer, 256) || !ascii(audience, 256)
+      || !Number.isSafeInteger(notBefore) || !Number.isSafeInteger(notAfter) || notBefore > now || now >= notAfter) throw Error();
+    const key = createPrivateKey(readFileSync(process.env.REMEDY_REVIEWER_SIGNING_KEY_FILE || ''));
+    if (key.asymmetricKeyType !== 'ed25519') throw Error();
+    const publicJWK = createPublicKey(key).export({ format: 'jwk' });
+    if (process.env.NODE_ENV === 'production' && (kid === 'lt1-public-test-only-v1' || publicJWK.x === 'W5zBuQB8Sgsyq_zEyl3ayl2idoWdGYhPXw6irKVur3Q')) throw Error();
+    return { key, kid, issuer: issuer!, audience: audience!, notBefore, notAfter };
+  } catch { throw reviewError('Reviewed writes are unavailable. The deployment operator must configure a valid signing key and validity window.', 503); }
+}
+
+/** Small native Node22 JWS interface; the payload is created exclusively from stored review data. */
+export function signReviewedOperation(config: SigningConfiguration, binding: any, subject: string, expiresAt: number,
+  now = Math.floor(Date.now() / 1000), jti = randomBytes(32).toString('base64url')) {
+  if (!Number.isSafeInteger(now) || !ascii(subject, 128) || !/^[A-Za-z0-9_-]{43}$/.test(jti) || Buffer.from(jti, 'base64url').toString('base64url') !== jti
+    || now < config.notBefore || now >= config.notAfter) throw reviewError('The reviewed operation cannot be signed.', 503);
+  const exp = Math.min(now + 60, expiresAt, config.notAfter);
+  if (!Number.isSafeInteger(exp) || exp <= now + 1) throw reviewError('This preview is expired or too close to expiry. Generate and review a new preview.');
+  const header = { alg: 'Ed25519', kid: config.kid, typ: 'remedy-review+jwt' };
+  const payload = { v: 1, iss: config.issuer, aud: config.audience, sub: subject, iat: now, nbf: now, exp, jti, binding };
+  const input = Buffer.from(JSON.stringify(header)).toString('base64url') + '.' + Buffer.from(JSON.stringify(payload)).toString('base64url');
+  const compact = input + '.' + sign(null, Buffer.from(input, 'ascii'), config.key).toString('base64url');
+  if (compact.length > 8192) throw reviewError('The reviewed operation exceeds the supported assertion size.');
+  return { assertion: compact, issuer: config.issuer, jti, exp };
+}
+
+/** Canonical local inputs bind the user's confirmation to the preview controls. */
+export function reviewInputs(body: any, kind: string) {
