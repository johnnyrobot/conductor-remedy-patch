+  }
+  if (value.outcome === 'pending' && value[active] === null && value.audit_recorded === null
+    && value.evidence_effect === 'hold' && value.reason === null && !value.requires_reconciliation && value.reconciliation === 'none') {
+    return { metadata: value, effect: 'hold', terminal: false };
+  }
