+    && ['no_change', 'pre_dispatch_failure', 'stale_preview', 'target_mismatch'].includes(value.reason)
+    && value.evidence_effect === (stale ? 'invalidate' : 'preserve') && !value.requires_reconciliation && value.reconciliation === 'none') {
+    return { metadata: value, effect: stale ? 'invalidate' : 'preserve', terminal: true };
+  }
+  if (value.outcome === 'known_success' && value[active] === true && typeof value.audit_recorded === 'boolean'
+    && value.evidence_effect === 'invalidate' && value.reason === null && !value.requires_reconciliation && value.reconciliation === 'none') {
