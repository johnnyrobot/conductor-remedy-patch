@@ -0,0 +1,14 @@
+/** Only a confirmed no_change outcome can claim a no-op or preserved source evidence. */
+export function remedyOutcome(result: any, action = 'apply') {
+  const active = action === 'restore' ? result.restored : result.applied;
+  const notWritten = result.outcome === 'not_attempted' || active === false;
+  const wrote = result.outcome === 'known_success' && active === true;
+  const noChange = result.outcome === 'not_attempted' && active === false && result.reason === 'no_change';
+  let message = 'Write outcome requires review. Keep the page blocked and read operation evidence; do not repeat the write.';
+  if (noChange) message = 'No changes were written: the preview contained no content change.';
+  else if (notWritten && result.reason === 'stale_preview') message = 'No changes were written. The page source changed. Rescan the page and review a new preview before writing.';
+  else if (notWritten && result.reason === 'target_mismatch') message = 'No changes were written. The page target changed. Refresh the stored page, rescan it and review a new preview before writing.';
+  else if (notWritten) message = 'No changes were written. Review operation evidence and generate a new preview before writing.';
+  else if (wrote) message = `${action === 'restore' ? 'Restore' : 'Apply'} completed.`;
+  return { notWritten, wrote, noChange, message };
+}
