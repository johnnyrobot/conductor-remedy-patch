+// Independent Python oracle models the producer's deployed binding digest.
+async function terminalPending(reason: string | null = null, audit = true) {
+ outcome='uncertain';const write=await request(`${matrix}/apply`,'POST',await reviewedInput());assert.equal(write.status,502);
+ const Records=mongoose.connection.db!.collection('remedyoperationrecords');
+ const intent=(await Records.findOne({projectID,localID:write.data.localOperationID,kind:'intent'}))!.event;
+ const {execFileSync}=await import('node:child_process');
+ const digest=execFileSync('python3',['-c','import sys,json,hashlib;print(hashlib.sha256(json.dumps(json.load(sys.stdin),sort_keys=True,separators=(\",\",\":\"),ensure_ascii=True).encode()).hexdigest())'],{input:JSON.stringify(intent.binding),encoding:'utf8'}).trim();
+ const key=intent.issuer+':'+intent.jti,old=operations.get(key),noop=reason!==null;
