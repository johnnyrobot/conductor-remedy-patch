+import React,{act} from 'react';import{screen,fireEvent,waitFor}from'@testing-library/react';import{test,expect,vi}from'vitest';
+test('standalone entry keeps healthy historical lookup visible when preview/writer readiness is unavailable',async()=>{
+ window.history.replaceState({},'','/projects/fixture/accessibility');const anchor=document.createElement('section');anchor.className='wcag-summary-segment';document.body.appendChild(anchor);
+ const fetcher=vi.fn(async(url:any,_options?:RequestInit)=>({ok:true,json:async()=>String(url).includes('remedy/health')?{err:false,available:false,capabilities:{scan:true,preview:false,mutate:false,operation_status:true}}:String(url).includes('/operations/')?{err:false,pending:true,operation:{outcome:'known_success'}}:{err:false,canEdit:true,items:[],users:[],candidates:[],sections:[{id:'page1',title:'Held article',pendingOperationID:'saved-operation'}]}}));vi.stubGlobal('fetch',fetcher);
+ try{
+  await act(async()=>{await import('./remediation-queue-entry');});
+  const button=await screen.findByRole('button',{name:'Read operation evidence'});expect(screen.queryByLabelText('Page tools')).toBeNull();expect(screen.queryByRole('button',{name:'Rescan page'})).toBeNull();
+  expect(fetcher.mock.calls.some(([url])=>String(url).includes('/operations/'))).toBe(false);fireEvent.click(button);await screen.findByText(/Write confirmed.*page remains blocked/);
+  expect(fetcher.mock.calls.every(([,options])=>!options||options.method===undefined||options.method==='GET')).toBe(true);
+ }finally{window.history.replaceState({},'','/');anchor.remove();await waitFor(()=>expect(document.querySelector('.remediation-work-queue')).toBeNull());vi.unstubAllGlobals();}
+});
