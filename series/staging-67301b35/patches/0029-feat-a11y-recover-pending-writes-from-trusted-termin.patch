+import {createHash} from 'node:crypto';
+import {checkedOutcome,reviewError,safeOperationMetadata} from './remedyReview.js';
+
+/** The deployed ledger uses Python ensure_ascii JSON, not JCS or raw JS JSON. */
+export function terminalBindingJSON(value: unknown): string {
+ const quote=(text:string)=>JSON.stringify(text).replace(/[\u007f-\uffff]/g,char=>'\\u'+char.charCodeAt(0).toString(16).padStart(4,'0'));
+ if(value===null)return 'null';
+ if(typeof value==='string')return quote(value);
+ if(typeof value==='number'&&Number.isSafeInteger(value))return JSON.stringify(value);
+ if(typeof value==='object'&&!Array.isArray(value)&&[Object.prototype,null].includes(Object.getPrototypeOf(value))){
+  const object=value as Record<string,unknown>,keys=Object.keys(object).sort();
+  if(keys.some(key=>/[^\x20-\x7e]/.test(key)))throw reviewError('Stored review binding is malformed. Keep the claim held.');
+  return '{'+keys.map(key=>quote(key)+':'+terminalBindingJSON(object[key])).join(',')+'}';
+ }
+ throw reviewError('Stored review binding is malformed. Keep the claim held.');
+}
+export const terminalBindingHash=(binding:unknown)=>createHash('sha256').update(terminalBindingJSON(binding),'utf8').digest('hex');
+
+function expectedEpoch(){
+ const value=process.env.REMEDY_REVIEWER_TRUST_EPOCH;
+ if(!value||value!==value.trim()||value.length>512||/[\x00-\x1f\x7f]/.test(value))
+  throw reviewError('Terminal-proof recovery requires REMEDY_REVIEWER_TRUST_EPOCH to match the coordinated Bridge epoch. Scan, preview and separate unknown-outcome recovery remain available.',503);
+ return value;
+}
+const record=(value:any)=>value!==null&&typeof value==='object'&&!Array.isArray(value);
+
+/** Only authenticated status plus original stored intent can qualify an explicit recovery. */
+export function checkedRecoveryStatus(raw:any,intent:any,knownOperationID?:string){
+ const invalid=()=>reviewError('The operation has no trusted matching terminal or durable operator-resolution proof. Keep the claim held.');
+ if(!['apply','restore'].includes(intent?.action)||typeof intent.issuer!=='string'||!intent.issuer||typeof intent.jti!=='string'||!intent.jti
+  ||intent.binding?.action!==`cxone.${intent.action}`)throw invalid();
+ const status=checkedOutcome(raw,intent.action);
+ if(!status||(knownOperationID!==undefined&&status.metadata.operation_id!==knownOperationID))throw invalid();
+ const operation=safeOperationMetadata(status.metadata);
+ if(status.metadata.outcome==='unknown_write'){
+  if(raw.terminal_proof!=null||status.metadata.reconciliation!=='resolved'||status.metadata.requires_reconciliation!==false)throw invalid();
+  return {operation,terminalProof:null,recoveryKind:'offline_operator_resolution'};
+ }
+ if(!status.terminal||!record(raw.terminal_proof))throw invalid();
+ const p=raw.terminal_proof,keys=['contract','issuer','jti','operation_id','action','target','binding_sha256','outcome','reason','audit_recorded','state','terminal_updated_at','trust_epoch','durability_seq'];
+ if(JSON.stringify(Object.keys(p).sort())!==JSON.stringify(keys.sort())||p.contract!=='cxone-terminal-v1'
+  ||p.issuer!==intent.issuer||p.jti!==intent.jti||p.operation_id!==operation.operation_id||p.action!==operation.action
+  ||!record(p.target)||JSON.stringify(Object.keys(p.target).sort())!==JSON.stringify(['hostname','page_id'])
+  ||p.target.hostname!==intent.binding.target?.hostname||p.target.page_id!==intent.binding.target?.page_id
+  ||typeof p.target.page_id!=='string'||!/^([1-9][0-9]*)$/.test(p.target.page_id)
+  ||typeof p.binding_sha256!=='string'||!/^[a-f0-9]{64}$/.test(p.binding_sha256)||p.binding_sha256!==terminalBindingHash(intent.binding)
+  ||p.outcome!==operation.outcome||p.reason!==operation.reason||p.audit_recorded!==operation.audit_recorded||p.state!=='terminal'
+  ||p.terminal_updated_at!==operation.updated_at||new Date(p.terminal_updated_at).toISOString()!==p.terminal_updated_at
+  ||!Number.isSafeInteger(p.durability_seq)||p.durability_seq<0)throw invalid();
+ if(p.trust_epoch!==expectedEpoch())throw invalid();
+ return {operation,terminalProof:structuredClone(p),recoveryKind:'trusted_terminal'};
+}
+
+export function sameRecoveryStatus(first:ReturnType<typeof checkedRecoveryStatus>,second:ReturnType<typeof checkedRecoveryStatus>){
+ if(JSON.stringify(first)!==JSON.stringify(second))throw reviewError('The authoritative proof changed during recovery. Keep the claim held and explicitly revalidate; never retry a write.');
+}
