--- /dev/null
+++ b/server/api/remedyrecovery.ts
@@ -0,0 +1,22 @@
+import {Response} from 'express';
+import {z} from 'zod';
+import {ZodReqWithUser} from '../types/Express.js';
+import middleware from '../middleware.js';
+import logger from '../logger.js';
+import {resolveRemedyOperationSchema} from './validators/remedy-resolution.js';
+import {resolveRemedyClaim} from './services/remedy-recovery.js';
+import {reviewError} from '../util/remedyReview.js';
+type ResolutionRequest=ZodReqWithUser<z.infer<typeof resolveRemedyOperationSchema>>&{queueProject:any;queueCanEdit:boolean;queueOperationAdmin:boolean};
+/** Administrative local recovery only, with existing auth/project policy. */
+export function registerRemedyRecovery(router:any,{base,access,Project,auth,bridge}:any){
+ router.post(`${base}/page/:sectionID/operations/:localID/resolve`,...access,middleware.validateZod(resolveRemedyOperationSchema),async(req:ResolutionRequest,res:Response)=>{
+  try{
+   if(!req.queueCanEdit||!req.queueOperationAdmin)throw reviewError('Support or superadmin project access is required for explicit resolution.',403);
+   const result=await resolveRemedyClaim({project:req.queueProject,projectID:req.params.projectID,sectionID:req.params.sectionID,localID:req.params.localID,actor:req.user.decoded.uuid,expectedVersion:req.body.expectedVersion,reason:req.body.reason},{Project,auth,bridge});
+   return res.json({err:false,...result});
+  }catch(error:any){
+   if(!error.publicMessage||(error.status||500)>=500)logger.error({err:{name:error.name,message:error.message,stack:error.stack},projectID:req.params.projectID,localOperationID:req.params.localID},'Administrative Remedy recovery failed');
+   return res.status(error.status||502).json({err:true,errMsg:error.publicMessage||'Resolution acknowledgement is unavailable. Refresh read-only operation evidence; do not automatically retry or clear a claim.'});
+  }
+ });
+}
