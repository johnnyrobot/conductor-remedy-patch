+import {BSON} from 'mongodb';
+import {createHash,randomUUID} from 'node:crypto';
+import {criteria} from '../../util/conformance.js';
+import {appendOperation,storedIntent} from '../../util/remedyOperationRecords.js';
+import {checkedOutcome,reviewError,safeOperationMetadata} from '../../util/remedyReview.js';
+type RecoveryInput={project:any;projectID:string;sectionID:string;localID:string;actor:string;expectedVersion:number;reason:string};
+function currentTarget(section:any,intent:any){
+ const url=new URL(section.sectionURL),path=decodeURIComponent(url.pathname);
+ if(url.origin!=='https://dev.libretexts.org'||url.username||url.password||/[\\\x00-\x1f]/.test(path)||path.split('/').some(part=>part==='.'||part==='..')||!path.startsWith('/Sandboxes/johnnyphung/')
+  ||intent.sectionURL!==section.sectionURL||intent.pageID!==section.pageID||intent.binding?.target?.hostname!==url.hostname||intent.binding.target.page_id!==section.pageID||intent.binding.target.page_path!==path.slice(1))
+  throw reviewError('The stored operation target changed. Keep the claim held and contact the operator.');
+ return {page_url:section.sectionURL,section_title:section.sectionTitle};
+}
+function freshScan(result:any,section:any,intent:any,started:number){
+ const review=result?.wcag_review||result?.wcagReview,at=Date.parse(review?.scannedAt),now=Date.now();
+ const statuses=new Set(['pass','fail','manual_review','not_tested','not_applicable']);
+ if(result?.err||result?.error||result?.scanError||result?.scan_error||result?.errors?.length||result?.engine_errors?.length
+  ||String(result?.page_id)!==section.pageID||result?.page_path!==intent.binding.target.page_path
+  ||!review||!/^([a-f0-9]{16}|[a-f0-9]{64})$/.test(review.sourceHash)||!Number.isFinite(at)||at<started-60_000||at>now+60_000
+  ||!Array.isArray(review.criteria)||review.criteria.length!==criteria.length||new Set(review.criteria.map((c:any)=>c.id)).size!==criteria.length
+  ||criteria.some(c=>!review.criteria.some((actual:any)=>actual.id===c.id&&statuses.has(actual.status)))
+  ||(review.rendered&&(review.rendered.state!=='complete'||review.rendered.sourceHash!==review.sourceHash||!review.rendered.renderedHash||!review.rendered.platformHash)))
+  throw reviewError('A fresh complete canonical scan is required. The pending claim was not released.',502);
+ if(BSON.calculateObjectSize({review,dojExceptions:result.doj_exceptions||result.dojExceptions||[]})>1024*1024)throw reviewError('Fresh scan evidence exceeds the explicit 1 MiB recovery budget. The claim remains held.',413);
+ return review;
+}
+
+/** Owns the read/proof/write-ahead/CAS recovery workflow; never dispatches a mutation. */
+export async function resolveRemedyClaim(input:RecoveryInput,{Project,auth,bridge}:any){
+   const sections=(input.project.a11yReview||[]).filter((section:any)=>String(section._id)===input.sectionID);
+   const section=sections[0],intent=await storedIntent(input.project,input.localID,input.sectionID);
+   if(!intent)throw reviewError('Operation is unavailable to this project user.',403);
+   if(sections.length!==1||!section.remedyWritePending||section.remedyPendingOperation!==intent.localID||(section.remedyEvidenceVersion||0)!==input.expectedVersion)
+    throw reviewError('The pending claim or evidence version changed. Refresh operation evidence before continuing.');
+   if((input.project.remedyResolutionCommits?.length||0)>=1000)throw reviewError('Project resolution history reached its explicit 1,000-marker safety limit. Preserve/export it and contact the operator.');
+   const target=currentTarget(section,intent);
+   const status=checkedOutcome(await bridge('operation-status',{issuer:intent.issuer,jti:intent.jti}),intent.action);
+   if(!status||status.metadata.reconciliation!=='resolved'||status.metadata.requires_reconciliation!==false||status.metadata.outcome!=='unknown_write')
+    throw reviewError('The Bridge operation has no durable administrative resolution. The local claim remains held.');
+   const started=Date.now();
+   // Explicit canonical read. Never send a preview, mutation or retry request.
+   const result=await bridge('scan',{...target,rendered:false,wcag_review:null,doj_exceptions:section.dojExceptions||[]});
+   const review=freshScan(result,section,intent,started);
+   const current=checkedOutcome(await bridge('operation-status',{issuer:intent.issuer,jti:intent.jti}),intent.action);
+   if(!current||current.metadata.reconciliation!=='resolved'||current.metadata.requires_reconciliation||current.metadata.outcome!=='unknown_write'||current.metadata.operation_id!==status.metadata.operation_id||current.metadata.updated_at!==status.metadata.updated_at)
+    throw reviewError('The durable operation status changed or became unavailable during the scan. The claim remains held.');
+   if(!await auth.checkHasRoleByID(input.actor,'libretexts',['support','superadmin']))throw reviewError('Administrative permission changed. The claim remains held.',403);
+   const resolutionID=randomUUID(),event={kind:'resolution',localID:intent.localID,sectionID:input.sectionID,resolutionID,
+    actor:input.actor,at:new Date(),reason:input.reason,phase:'prepared_for_local_cas',expectedVersion:input.expectedVersion,
+    originalActor:intent.actor,issuer:intent.issuer,jti:intent.jti,action:intent.action,target:intent.binding.target,
+    operation:safeOperationMetadata(status.metadata),scanHash:createHash('sha256').update(JSON.stringify(review)).digest('hex'),scannedAt:review.scannedAt};
+   // Journal preparation before CAS; a bounded append-only marker in that same
+   // Project CAS permanently identifies the winner, even after a TOC removal.
+   await appendOperation(input.projectID,event);
+   const saved=await Project.updateOne({projectID:input.projectID,
+    $expr:{$and:[...['members','leads','liaisons','orgID'].map(key=>({$eq:[{$ifNull:[`$${key}`,key==='orgID'?'':[]]},{$literal:input.project[key]??(key==='orgID'?'':[])}]})),{$lt:[{$size:{$ifNull:['$remedyResolutionCommits',[]]}},1000]},{$lt:[{$bsonSize:'$$ROOT'},12*1024*1024]}]},
+    a11yReview:{$elemMatch:{_id:section._id,sectionURL:section.sectionURL,pageID:section.pageID,remedyWritePending:true,remedyPendingOperation:intent.localID,
+     remedyEvidenceVersion:input.expectedVersion===0?{$in:[null,0]}:input.expectedVersion}}},
+    {$set:{'a11yReview.$.wcagReview':review,'a11yReview.$.dojExceptions':result.doj_exceptions||result.dojExceptions||[],
+      'a11yReview.$.remedyError':'','a11yReview.$.remedyLastScannedAt':new Date(),'a11yReview.$.remedyWritePending':false,
+      'a11yReview.$.remedyResolutionEpoch':resolutionID,'a11yReview.$.remedyLastResolution':{id:resolutionID,localID:intent.localID,actor:input.actor,at:event.at,scanHash:event.scanHash}},
+     $push:{remedyResolutionCommits:{id:resolutionID,localID:intent.localID,actor:input.actor,at:event.at,evidenceVersion:input.expectedVersion+1}},
+     $inc:{'a11yReview.$.remedyEvidenceVersion':1},$unset:{'a11yReview.$.remedyPendingOperation':'','a11yReview.$.remedyReviewedPreview':''}},
+    {writeConcern:{w:'majority',j:true,wtimeout:10000}});
+   if(saved.acknowledged===false||saved.matchedCount!==1)throw reviewError('The page or claim changed during resolution. No conflicting evidence was overwritten.');
+   return {resolved:true,resolutionID,localOperationID:intent.localID,evidenceVersion:input.expectedVersion+1,operation:safeOperationMetadata(status.metadata),message:'The matching local claim was resolved after a fresh scan. Human conformance remains pending.'};
+}
