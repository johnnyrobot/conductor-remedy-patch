+import { requireRemedyConfiguration } from './remedyConfig.js';
+import mongoose from 'mongoose';
+import { BSON } from 'mongodb';
+
+// Immutable write-ahead events; only section.remedyPendingOperation is active.
+// Auto creation stays off: enabled health preflight owns explicit index setup.
+const schema = new mongoose.Schema({
+  projectID: { type: String, required: true }, localID: { type: String, required: true },
+  kind: { type: String, required: true }, sectionID: String, actor: String,
+  issuer: String, jti: String, event: { type: mongoose.Schema.Types.Mixed, required: true },
+}, { timestamps: true, autoCreate: false, autoIndex: false });
+schema.index({ projectID: 1, localID: 1, kind: 1, _id: -1 });
+schema.index({projectID:1,localID:1},{unique:true,partialFilterExpression:{kind:'intent'}});
+schema.index({ issuer: 1, jti: 1 }, { unique: true, partialFilterExpression: { kind: 'intent' } });
+export const remedyOperationRecords = () => mongoose.models.RemedyOperationRecord || mongoose.model('RemedyOperationRecord', schema);
+let ready:Promise<void>|undefined;
+export async function ensureOperationStorage(){
+ requireRemedyConfiguration();
+ if(!ready)ready=(async()=>{const Records=remedyOperationRecords();await Records.createCollection();await Records.createIndexes();})().catch(error=>{ready=undefined;throw error;});
+ return ready;
+}
+export async function appendOperation(projectID: string, event: any, Records?:any) {
+  if(!Records){await ensureOperationStorage();Records=remedyOperationRecords();}
+  if (BSON.calculateObjectSize(event) > 65536) throw Error('Operation metadata exceeds the supported 64 KiB event budget.');
+  return Records.create([{ projectID, localID: event.localID, kind: event.kind,
+    sectionID: event.sectionID, actor: event.actor, issuer: event.issuer, jti: event.jti, event }], {writeConcern:{w:'majority',j:true,wtimeout:10000}});
+}
