+import mongoose from 'mongoose';
+import { conformanceReport, criteria, pageFingerprint } from './conformance.js';
+import { remediationHandoff } from './remediationHandoff.js';
+export const READ_TIMEOUT_MS = 30_000;
+const order = {createdAt:-1,_id:-1};
+const audited = (r:any) => r ? {...r.data,_id:r._id,sectionID:r.sectionID,actor:r.actor,at:r.at} : null;
+export function pagination(query:any) {
+  const limit=query.limit===undefined?100:Number(query.limit);
+  if(!Number.isInteger(limit)||limit<1||limit>200) throw Object.assign(Error('Choose a limit from 1 through 200.'),{status:400});
+  let cursor:any=null;
+  if(query.cursor!==undefined) {
+    try { if(typeof query.cursor!=='string'||query.cursor.length>1024) throw Error(); cursor=JSON.parse(Buffer.from(query.cursor,'base64url').toString()); if(!cursor||typeof cursor!=='object') throw Error(); }
+    catch {throw Object.assign(Error('Invalid cursor. Refresh the first page.'),{status:400});}
+  }
+  return {limit,cursor};
+}
+export const encodeCursor = (value:any) => Buffer.from(JSON.stringify(value)).toString('base64url');
+export function compactPage(page:any) {
+  if(String(page.title||'').length>2000||String(page.url||'').length>8192)throw Object.assign(Error('Page metadata exceeds the bounded summary budget; request the full export for operator inspection.'),{status:413});
+  const {sourceScan,criteria:results,...fields}=page;
+  return {...fields,criteria:results.map((c:any)=>({id:c.id,status:c.status}))};
+}
+export async function recordSnapshot(Records:any,signal?:AbortSignal) {
+  const newest=await Records.findOne().sort({_id:-1}).select('_id').setOptions({signal}).maxTimeMS(READ_TIMEOUT_MS).lean();
+  return newest?._id || new mongoose.Types.ObjectId('000000000000000000000000');
+}
+export async function loadConformance(project:any,Records:any,{full=false,snapshot,scope:fixedScope,signal,now=Date.now(),criterionID}:any={}) {
+  const fence=snapshot?{_id:{$lte:snapshot}}:{};
+  const latest=async(kind:string,extra:any={})=>Records.findOne({projectID:project.projectID,kind,...fence,...extra}).sort(order).setOptions({signal}).maxTimeMS(READ_TIMEOUT_MS).lean();
+  const scope=fixedScope===undefined?(await latest('scope'))?.data:fixedScope;
+  const sections=project.a11yReview||[];
+  const fingerprints=new Map<string,Set<unknown>>();
+  for(const section of sections){const id=String(section._id);let values=fingerprints.get(id);if(!values)fingerprints.set(id,values=new Set());values.add(pageFingerprint(section));}
+  const allowed=new Set(criterionID?[criterionID]:criteria.map(c=>c.id));
+  const current=new Map<string,Map<string,Map<unknown,any>>>(),pairs=new Map<string,Set<string>>();
+  const expected=[...fingerprints.values()].reduce((count,values)=>count+values.size*allowed.size,0);let matched=0;
+  // Read only selection metadata, in the exact historical order. A hash lookup
+  // per record avoids an OR branch per page and never reads superseded notes.
+  const cursor=Records.collection.find({projectID:project.projectID,kind:'review',sectionID:{$in:[...fingerprints.keys()]},'data.criterionID':{$in:[...allowed]},...fence},
+    {sort:order,projection:{_id:1,sectionID:1,'data.criterionID':1,'data.scopeVersion':1,'data.fingerprint':1,'data.status':1},batchSize:200,maxTimeMS:READ_TIMEOUT_MS});
+  let closing:Promise<any>|undefined,expired=false;
+  const close=()=>closing||=(cursor.close().catch(()=>{}));
+  const abort=()=>{void close();};signal?.addEventListener('abort',abort,{once:true});
+  const timer=setTimeout(()=>{expired=true;void close();},READ_TIMEOUT_MS);timer.unref();
+  try {
+    while(!expired&&!signal?.aborted){
+      const record=await cursor.next();if(!record)break;
+      const sectionID=String(record.sectionID),id=record.data?.criterionID;
+      if(!fingerprints.has(sectionID)||!allowed.has(id))continue;
+      let seen=pairs.get(sectionID);if(!seen)pairs.set(sectionID,seen=new Set());seen.add(id);
+      if(fingerprints.get(sectionID)!.has(record.data.fingerprint)&&record.data.scopeVersion===scope?.version){
+        let page=current.get(sectionID);if(!page)current.set(sectionID,page=new Map());
+        let criterion=page.get(id);if(!criterion)page.set(id,criterion=new Map());
+        if(!criterion.has(record.data.fingerprint)){criterion.set(record.data.fingerprint,record);matched++;}
+        if(matched===expected)break;
+      }
+    }
+    if(expired||signal?.aborted)throw Error('Conformance selection cancelled or exceeded its read budget.');
+  }finally{clearTimeout(timer);signal?.removeEventListener('abort',abort);await close();}
+  const selectedRecords=[...current.values()].flatMap(page=>[...page.values()].flatMap(criterion=>[...criterion.values()]));
+  const selected=full?await Records.find({projectID:project.projectID,_id:{$in:selectedRecords.map(record=>record._id)}}).limit(selectedRecords.length||1).setOptions({signal}).maxTimeMS(READ_TIMEOUT_MS).lean():selectedRecords;
+  const reviews=selected.map(audited);
+  for(const [sectionID,ids] of pairs)for(const id of ids)reviews.push({sectionID,criterionID:id,fingerprint:'stale-sentinel',scopeVersion:'stale-sentinel'});
+  const report=conformanceReport(project,scope,reviews,[],now);
+  const signoff=report.readyForSignoff?audited(await latest('signoff',{'data.digest':report.digest})):null;
+  if(signoff){report.signoff=signoff;report.status='verified_for_evaluated_scope';}
+  const handoff=remediationHandoff(report,[],now);
+  const accepted=audited(await latest('remediation_signoff',{'data.digest':handoff.digest}));
+  const anyHandoff=accepted||await latest('remediation_signoff');
+  return {scope,report:{...report,remediationHandoff:remediationHandoff(report,accepted?[accepted]:anyHandoff?[{digest:'unmatched'}]:[],now)}};
+}
+
+/** Stable IDs, bounded output and explicit continuation for embedded metadata. */
+export function paginateValues(values:any[],query:any,binding:any,key:(value:any)=>string){
+ const {limit,cursor}=pagination(query);
+ if(cursor&&(Object.entries(binding).some(([name,value])=>cursor[name]!==value)||typeof cursor.after!=='string'))throw Object.assign(Error('Invalid list cursor.'),{status:400});
+ const sorted=[...values].sort((a,b)=>key(a)<key(b)?-1:key(a)>key(b)?1:0).filter(value=>!cursor||key(value)>cursor.after);
+ const entries=sorted.slice(0,limit);
+ return {entries,total:values.length,nextCursor:sorted.length>limit?encodeCursor({...binding,after:key(entries.at(-1))}):null};
+}
