@@ -0,0 +1,30 @@
+import React from 'react';
+import {render,screen,fireEvent,waitFor,cleanup} from '@testing-library/react';
+import {test,expect,vi,afterEach} from 'vitest';
+import ConformanceReview from './ConformanceReview';
+afterEach(()=>{cleanup();vi.unstubAllGlobals();});
+test('mounted verification loads bounded summaries then selected detail and cursor history',async()=>{
+ const paths:string[]=[];
+ const criterion={id:'1.1.1',title:'Non-text Content',status:'unreviewed',checklist:['Compare images']};
+ const page={sectionID:'page1',title:'First page',url:'https://fixture.invalid/',fingerprint:'fp',blockers:[],criteria:[{id:criterion.id,status:criterion.status}]};
+ vi.stubGlobal('fetch',vi.fn(async(url:any)=>{
+  paths.push(String(url));let body:any;
+  if(String(url).includes('/criteria/'))body={criterion};
+  else if(String(url).includes('/pages/'))body={page:{...page,sourceScan:{rendered:{state:'complete'}}}};
+  else if(String(url).includes('/history'))body={records:[{_id:'history1',actor:'Synthetic reviewer',data:{notes:'Earlier immutable reviewer evidence'}}],nextCursor:null};
+  else body={canEdit:true,criteria:[criterion],report:{scope:{version:'scope1'},pages:[page],digest:'digest',verificationPercent:0,verifiedCriteria:0,totalCriteria:50,status:'verification_pending',readyForSignoff:false}};
+  return {ok:true,json:async()=>({err:false,...body})};
+ }));
+ render(<ConformanceReview projectID="bounded" sections={[]}/>);
+ await screen.findByLabelText('Page to evaluate');expect(paths).toHaveLength(1);
+ fireEvent.change(screen.getByLabelText('Page to evaluate'),{target:{value:'page1'}});
+ await screen.findByLabelText('Compare images');
+ expect(paths.some(p=>p.endsWith('/conformance/pages/page1'))).toBe(true);
+ expect(paths.some(p=>p.endsWith('/conformance/pages/page1/criteria/1.1.1'))).toBe(true);
+ expect(paths.some(p=>p.includes('/history'))).toBe(false);
+ await waitFor(()=>expect(screen.getByRole('button',{name:'View review history'})).toBeEnabled());
+ fireEvent.click(screen.getByRole('button',{name:'View review history'}));
+ await screen.findByText(/Earlier immutable reviewer evidence/);
+ await waitFor(()=>expect(paths.filter(p=>p.includes('/history'))).toHaveLength(1));
+ expect(paths.find(p=>p.includes('/history'))).toContain('sectionID=page1&criterionID=1.1.1');
+});
