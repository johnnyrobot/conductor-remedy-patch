+import { BSON } from 'mongodb';
+export const MAX_WORK_ITEM_EVENTS=1000;
+export const MAX_WORK_ITEM_BYTES=8*1024*1024;
+export const workItemAppendBudget={ $expr:{$and:[
+ {$lt:[{$size:{$ifNull:['$history',[]]}},MAX_WORK_ITEM_EVENTS]},
+ {$lt:[{$size:{$ifNull:['$scanEvidence',[]]}},MAX_WORK_ITEM_EVENTS]},
+ {$lt:[{$bsonSize:'$$ROOT'},MAX_WORK_ITEM_BYTES]},
+]} };
+export function requireWorkItemBudget(item:any){
+ if((item.history?.length||0)>=MAX_WORK_ITEM_EVENTS||(item.scanEvidence?.length||0)>=MAX_WORK_ITEM_EVENTS||BSON.calculateObjectSize(item)>=MAX_WORK_ITEM_BYTES)
+  throw Object.assign(Error('Task history reached its explicit safety budget. Preserve/export it and contact the operator; no history was discarded.'),{status:409,code:'remedy_history_budget',publicMessage:'Task history reached its explicit safety budget. Preserve/export it and contact the operator; no history was discarded.'});
+}
+export function requireEventBudget(event:any){
+ if(BSON.calculateObjectSize(event)>65536)throw Object.assign(Error('Task evidence exceeds the supported 64 KiB event budget. No evidence was truncated.'),{status:413,code:'remedy_history_budget',publicMessage:'Task evidence exceeds the supported 64 KiB event budget. No evidence was truncated.'});
