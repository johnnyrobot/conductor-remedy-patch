+++ b/server/util/remedyExports.ts
@@ -0,0 +1,17 @@
+import { once } from 'node:events';
+/** HTTP backpressure, client cancellation and a fixed total export deadline. */
+export function beginRemedyExport(res:any) {
+ let closed=false;const cursors:any[]=[];const controller=new AbortController();
+ // Close once. Concurrent close calls can end the driver's implicit session
+ // before its first killCursors command executes, leaving an idle server cursor.
+ const close=()=>{if(closed)return;closed=true;controller.abort();for(const cursor of cursors)void cursor.close().catch(()=>{});};
+ res.once('close',close);
+ const timer=setTimeout(()=>{close();res.destroy(Error('Export exceeded its 120 second budget.'));},120_000);timer.unref();
+ return {
+  signal:controller.signal,
+  // Streaming cursors use this explicit lifecycle, not the query abort signal.
+  openCursor(factory:()=>any){if(closed)throw Error('Export cancelled.');const cursor=factory();cursors.push(cursor);return cursor;},
+  async write(text:string){if(closed)throw Error('Export cancelled.');if(!res.write(text))await once(res,'drain',{signal:controller.signal});},
+  dispose(){clearTimeout(timer);close();res.off('close',close);},
+ };
+}
