@@ -0,0 +1,76 @@
+import React from 'react';
+import { render, screen, fireEvent, waitFor, cleanup } from '@testing-library/react';
+import { afterEach, test, expect, vi } from 'vitest';
+import ConformanceReview from './ConformanceReview';
+
+afterEach(() => { cleanup(); vi.unstubAllGlobals(); });
+
+function setup() {
+  let fingerprint: string | null = 'evidence-A';
+  let scopeVersion = 'scope-1';
+  const submissions: any[] = [];
+  vi.stubGlobal('fetch', vi.fn(async (_url, init) => {
+    if (init?.method === 'POST') submissions.push(JSON.parse(init.body));
+    return { ok: true, json: async () => ({ err: false, canEdit: true, report: {
+      scope: { version: scopeVersion }, pages: [{ sectionID: 'page1', title: 'Synthetic article', url: 'https://fixture.invalid/',
+        fingerprint, blockers: [], criteria: [{ id: '1.1.1', title: 'Non-text Content', status: 'unreviewed', checklist: ['Compare every image with its description'] }] }],
+      verificationPercent: 0, verifiedCriteria: 0, totalCriteria: 50, status: 'verification_pending', readyForSignoff: false, digest: 'digest', remediationHandoff: null,
+    } }) };
+  }));
+  render(<ConformanceReview projectID="synthetic" sections={[]} />);
+  return { submissions, changeEvidence(value: string | null) { fingerprint = value; }, changeScope(value: string) { scopeVersion = value; } };
+}
+async function fillReview() {
+  fireEvent.change(await screen.findByLabelText('Page to evaluate'), { target: { value: 'page1' } });
+  fireEvent.click(screen.getByLabelText('Compare every image with its description'));
+  fireEvent.change(screen.getByLabelText(/Test environment/), { target: { value: 'Synthetic browser and screen reader' } });
+  fireEvent.change(screen.getByLabelText(/Evidence and results/), { target: { value: 'I compared all descriptions against the current synthetic article.' } });
+  fireEvent.click(screen.getByLabelText(/I performed this review/));
+}
+async function refresh() {
+  const calls = vi.mocked(fetch).mock.calls.length;
+  fireEvent.click(screen.getByRole('button', { name: 'Refresh verification' }));
+  await waitFor(() => expect(fetch).toHaveBeenCalledTimes(calls + 1));
+}
+
+test('changed evidence requires a new checklist and confirmation before saving', async () => {
+  const fixture = setup();
+  await fillReview();
+  fixture.changeEvidence('evidence-B');
+  await refresh();
+  await waitFor(() => expect(screen.getByLabelText(/I performed this review/)).not.toBeChecked());
+  expect(screen.getByLabelText('Compare every image with its description')).not.toBeChecked();
+  expect(screen.getByRole('button', { name: 'Save reviewer evidence' })).toBeDisabled();
+  expect(screen.getByLabelText('Page to evaluate')).toHaveValue('page1');
+  expect(screen.getByLabelText('Criterion')).toHaveValue('1.1.1');
+  expect(fixture.submissions).toEqual([]);
+  await fillReview();
+  fireEvent.click(screen.getByRole('button', { name: 'Save reviewer evidence' }));
+  await waitFor(() => expect(fixture.submissions).toHaveLength(1));
+  expect(fixture.submissions[0]).toMatchObject({ fingerprint: 'evidence-B', confirmed: true, checks: [0] });
+});
+
+test('scope changes reset the review while unchanged identity preserves a draft', async () => {
+  const fixture = setup();
+  await fillReview();
+  await refresh();
+  expect(screen.getByLabelText(/I performed this review/)).toBeChecked();
+  expect(screen.getByLabelText(/Evidence and results/)).toHaveValue('I compared all descriptions against the current synthetic article.');
+  fixture.changeScope('scope-2');
+  await refresh();
+  await waitFor(() => expect(screen.getByLabelText(/I performed this review/)).not.toBeChecked());
+  expect(screen.getByLabelText('Compare every image with its description')).not.toBeChecked();
+  expect(screen.getByRole('button', { name: 'Save reviewer evidence' })).toBeDisabled();
+  expect(fixture.submissions).toEqual([]);
+});
+
+test('invalidated evidence cannot be confirmed and saved', async () => {
+  const fixture = setup();
+  await fillReview();
+  fixture.changeEvidence(null);
+  await refresh();
+  await waitFor(() => expect(screen.getByLabelText(/I performed this review/)).not.toBeChecked());
+  await fillReview();
+  expect(screen.getByRole('button', { name: 'Save reviewer evidence' })).toBeDisabled();
+  expect(fixture.submissions).toEqual([]);
+});
