diff --git a/server/api/projects.js b/server/api/projects.js
index f203bbbf..e76b8729 100644
--- a/server/api/projects.js
+++ b/server/api/projects.js
@@ -2821,17 +2821,20 @@ const checkProjectRemedyHealth = async (req, res) => {
         try {
             await ensureRemedyStorage();
             const response = await axios.get(`${config.base}/v1/cxone/health`, {
-                headers: { 'X-API-Key': config.key }, timeout: 10000,
+                headers: { 'X-API-Key': config.key }, timeout: 5000, signal: AbortSignal.timeout(5000),
                 maxRedirects: 0, validateStatus: () => true,
             });
             const readiness = checkedRemedyReadiness(response.status, response.data);
             return res.json({ err: false, ok: readiness.available, ...capability, ...readiness,
                 state: readiness.available ? 'ready' : 'degraded',
                 message: readiness.available ? '' : readiness.readRetry ? 'A review dependency failed. Retry a scan or preview after the connection recovers. Automatic edits remain unavailable.' : 'Remedy is unavailable. An operator must check the configured capabilities.' });
-        } catch (_error) {
+        } catch (error) {
+            const timedOut = axios.isAxiosError(error) && ['ECONNABORTED', 'ETIMEDOUT', 'ERR_CANCELED'].includes(error.code);
             return res.json({ err: false, ok: false, ...capability, available: false, state: 'unavailable',
                 capabilities: { scan: false, preview: false, mutate: false, operation_status: false },
-                message: 'Remedy is unavailable. An operator must check its configuration, storage and connection.' });
+                message: timedOut
+                    ? 'Remedy did not respond within 5 seconds. An operator must check its connection before checking availability again.'
+                    : 'Remedy is unavailable. An operator must check its configuration, storage and connection.' });
         }
     } catch (_error) {
         return res.status(500).json({ err: true, errMsg: 'Unable to check Remedy availability.' });
diff --git a/server/integration/remedy-routes.test.ts b/server/integration/remedy-routes.test.ts
index 5787ac7e..8d34a14f 100644
--- a/server/integration/remedy-routes.test.ts
+++ b/server/integration/remedy-routes.test.ts
@@ -38,6 +38,7 @@ writeFileSync(keyPath, keys.privateKey.export({ format: 'pem', type: 'pkcs8' }),
 const previews = new Map<string, any>(), operations = new Map<string, any>();
 let previewExpiry = 0, invalidBinding = false, operationReady = true;
 let readinessOverride: any = null;
+let stalledHealth: 'none' | 'silent' | 'trickle' = 'none';
 let observedVerified: number | undefined;
 let holdScan: (() => Promise<void>) | undefined;
 let holdWrite: (() => Promise<void>) | undefined;
@@ -89,6 +90,14 @@ before(async () => {
   bridge = http.createServer(async (req, res) => {
     let raw = ''; for await (const part of req) raw += part;
     const body = raw ? JSON.parse(raw) : {};
+    if (req.url === '/v1/cxone/health' && stalledHealth === 'silent') return;
+    if (req.url === '/v1/cxone/health' && stalledHealth === 'trickle') {
+      res.writeHead(200, { 'Content-Type': 'application/json' });
+      const interval = setInterval(() => res.write(' '), 250);
+      const watchdog = setTimeout(() => res.end('{"ok":true}'), 8_000);
+      res.once('close', () => { clearInterval(interval); clearTimeout(watchdog); });
+      return;
+    }
     if (req.url === '/v1/cxone/health') { if(readinessOverride?.ok===false)res.statusCode=503; assert.equal(req.headers['x-api-key'], 'synthetic_not_real'); res.setHeader('Content-Type','application/json'); return res.end(JSON.stringify(readinessOverride || { ok: true, state: "ready", capabilities: { scan: true, preview: true, mutate: true, operation_status: operationReady } })); }
     calls.push({ path: req.url!, body });
     if (rejectAction) { res.writeHead(503); return res.end(JSON.stringify({ detail: 'Rejected key synthetic_not_real at private-engine.example.invalid' })); }
@@ -1162,3 +1171,27 @@ test('a current admin role is required after post-preparation proof revalidation
  await User.updateOne({uuid:users.auditor},{$set:{roles:[{org:'libretexts',role:'user'}]}});release();assert.equal((await pending).status,403);
  assert.equal((await Project.findOne({projectID}).lean())!.a11yReview[0].remedyWritePending,true);
 });
+
+
+for (const mode of ['silent', 'trickle'] as const) test(`registered health route bounds ${mode} engine to five seconds with sanitized feedback`, { timeout: 12_000 }, async () => {
+  stalledHealth = mode;
+  try {
+    const started = performance.now();
+    const response = await request(`${matrix}/health?projectID=${projectID}`);
+    const elapsed = performance.now() - started;
+    assert.ok(elapsed >= 4_500 && elapsed < 7_500, `health deadline elapsed ${elapsed}ms`);
+    assert.equal(response.status, 200);
+    assert.equal(response.data.err, false);
+    assert.equal(response.data.available, false);
+    assert.equal(response.data.state, 'unavailable');
+    assert.deepEqual(response.data.capabilities, { scan: false, preview: false, mutate: false, operation_status: false });
+    assert.match(response.data.message, /did not respond within 5 seconds/);
+    assert.match(response.data.message, /operator.*connection/i);
+    assert.doesNotMatch(JSON.stringify(response.data), /synthetic_not_real|127\.0\.0\.1|X-API-Key|AxiosError/);
+    assert.equal(calls.length, 0);
+  } finally { stalledHealth = 'none'; }
+  const ready = await request(`${matrix}/health?projectID=${projectID}`);
+  assert.equal(ready.status, 200);
+  assert.equal(ready.data.available, true);
+  assert.deepEqual(ready.data.capabilities, { scan: true, preview: true, mutate: true, operation_status: true });
+});
