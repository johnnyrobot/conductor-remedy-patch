diff --git a/server/util/remedyQueueReads.ts b/server/util/remedyQueueReads.ts
new file mode 100644
index 00000000..986b8120
--- /dev/null
+++ b/server/util/remedyQueueReads.ts
@@ -0,0 +1,54 @@
+import mongoose from 'mongoose';
+import { encodeCursor, READ_TIMEOUT_MS } from './conformanceReads.js';
+import { queueStatuses } from './remediationqueue.js';
+
+const profile = 'bounded-v2';
+const openStatuses = queueStatuses.filter(status => status !== 'verified');
+const invalid = (message: string) => Object.assign(Error(message), { status: 400 });
+const id = (value: unknown): value is string => typeof value === 'string' && /^[a-f0-9]{24}$/.test(value);
+const cursorKeys = ['kind', 'view', 'projectID', 'status', 'upper', 'after'].sort();
+
+/** Queue items only. Other lists and the legacy profile retain their contracts. */
+export async function boundedQueueItems(WorkItems: any, projectID: string, query: any) {
+  if (query.view !== profile) throw invalid('Unknown queue view. Use bounded-v2 or omit view for the legacy list.');
+  if (query.limit !== undefined && (typeof query.limit !== 'string' || !/^[1-9]\d{0,2}$/.test(query.limit)))
+    throw invalid('Choose a limit from 1 through 100.');
+  const limit = query.limit === undefined ? 100 : Number(query.limit);
+  if (limit > 100) throw invalid('Choose a limit from 1 through 100.');
+  const status = query.status === undefined ? 'open' : query.status;
+  if (typeof status !== 'string' || !['all', 'open', ...queueStatuses].includes(status))
+    throw invalid('Choose a valid queue status.');
+  let cursor: any = null;
+  if (query.cursor !== undefined) {
+    try {
+      const encoded = query.cursor;
+      if (typeof encoded !== 'string' || encoded.length > 1024 || !/^[A-Za-z0-9_-]+$/.test(encoded)) throw Error();
+      const text = Buffer.from(encoded, 'base64url').toString('utf8');
+      if (Buffer.from(text).toString('base64url') !== encoded) throw Error();
+      cursor = JSON.parse(text);
+      if (encodeCursor(cursor) !== encoded) throw Error();
+      if (!cursor || Array.isArray(cursor) || Object.keys(cursor).sort().join() !== cursorKeys.join() ||
+          cursor.kind !== 'queue-items-v2' || cursor.view !== profile || cursor.projectID !== projectID || cursor.status !== status ||
+          !id(cursor.upper) || !id(cursor.after) || cursor.after > cursor.upper) throw Error();
+    } catch { throw invalid('Invalid queue cursor. Refresh the first batch.'); }
+  }
+  const newest = cursor ? null : await WorkItems.findOne({ projectID }).sort({ _id: -1 }).select('_id').maxTimeMS(READ_TIMEOUT_MS).lean();
+  const upper = cursor?.upper || String(newest?._id || '000000000000000000000000');
+  const matching = { projectID, _id: { $lte: new mongoose.Types.ObjectId(upper) },
+    ...(status === 'all' ? {} : { status: status === 'open' ? { $in: openStatuses } : status }) };
+  const [total, found] = await Promise.all([
+    WorkItems.countDocuments(matching).maxTimeMS(READ_TIMEOUT_MS),
+    WorkItems.find({ ...matching, _id: { ...matching._id, ...(cursor ? { $lt: new mongoose.Types.ObjectId(cursor.after) } : {}) } })
+      .sort({ _id: -1 }).select('-history -scanEvidence').limit(limit + 1).maxTimeMS(READ_TIMEOUT_MS).lean(),
+  ]);
+  const items = found.slice(0, limit), hasMore = found.length > limit;
+  return { items, nextCursor: hasMore ? encodeCursor({ kind: 'queue-items-v2', view: profile, projectID, status, upper, after: String(items.at(-1)._id) }) : null,
+    lists: { items: { total, returned: items.length, complete: !cursor && !hasMore && items.length === total, hasMore,
+      countConsistency: 'Request-observed count and batch; initial upper-ID creation fence. Mutable statuses and separate queries are not a snapshot. Refresh after edits.' } } };
+}
+
+export function boundedQueueJSON(payload: unknown) {
+  const text = JSON.stringify(payload);
+  if (Buffer.byteLength(text) > 1_048_576) throw Object.assign(Error('Work queue response exceeds 1 MiB. Choose a smaller limit or use the complete authenticated work-item export.'), { status: 413 });
+  return text;
+}
