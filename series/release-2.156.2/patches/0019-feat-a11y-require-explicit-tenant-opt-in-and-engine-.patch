@@ -0,0 +1,46 @@
+/** One deployment opts in one explicitly named organization; projects remain authoritative. */
+export function remedyConfiguration(project?: { orgID?: string }) {
+  const unavailable = (state: string, code: string, message: string) => ({
+    enabled: false, available: false, state, code, message,
+    capabilities: { scan: false, preview: false, mutate: false, operation_status: false },
+  });
+  if (process.env.REMEDY_ENABLED !== 'true') {
+    return unavailable('disabled', 'remedy_disabled', 'Remedy is not enabled for this deployment.');
+  }
+  const tenant = process.env.REMEDY_ORG_ID;
+  if (!tenant || tenant !== process.env.ORG_ID) {
+    return unavailable('misconfigured', 'remedy_configuration', 'Remedy requires an explicit organization matching this deployment.');
+  }
+  if (project && project.orgID !== tenant) {
+    return unavailable('disabled', 'remedy_tenant_disabled', 'Remedy is not enabled for this project organization.');
+  }
+  try {
+    const raw = process.env.REMEDY_API_BASE_URL;
+    const key = process.env.REMEDY_API_KEY;
+    if (!raw || !key || !key.trim() || /[\r\n]/.test(key)) throw Error();
+    const url = new URL(raw);
+    const loopback = ['localhost', '127.0.0.1', '[::1]'].includes(url.hostname);
+    if ((url.protocol !== 'https:' && !(url.protocol === 'http:' && loopback))
+      || url.username || url.password || url.search || url.hash
+      || (url.pathname !== '/' && url.pathname !== '')) throw Error();
+    return { enabled: true, available: true, state: 'configured', code: '', message: '',
+      capabilities: { scan: true, preview: true, mutate: true, operation_status: false },
+      base: url.origin, key };
+  } catch {
+    return unavailable('misconfigured', 'remedy_configuration', 'Remedy requires an explicit engine URL and API key. Use HTTPS off-host.');
+  }
+}
+
+/** Safe feature errors never include the configured URL, key, or upstream response. */
+export function requireRemedyConfiguration(project?: { orgID?: string }) {
+  const config = remedyConfiguration(project);
+  if (!config.available) {
+    throw Object.assign(Error(config.message), { status: 503, code: config.code, publicMessage: config.message });
+  }
+  return config as typeof config & { base: string; key: string };
+}
+
+export function publicRemedyCapability(config: ReturnType<typeof remedyConfiguration>) {
+  const { enabled, available, state, code, message, capabilities } = config;
+  return { enabled, available, state, code, message, capabilities };
+}
