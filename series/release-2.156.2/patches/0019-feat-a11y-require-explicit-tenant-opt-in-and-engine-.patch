+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { MemoryRouter } from 'react-router-dom';
+import { afterEach, expect, test, vi } from 'vitest';
+import axios from 'axios';
+import ProjectAccessibility from './ProjectAccessibility';
+
+vi.mock('axios', () => ({ default: { get: vi.fn(), post: vi.fn() } }));
+vi.mock('react-redux', () => ({ useSelector: () => ({ uuid: 'editor', roles: [] }) }));
+vi.mock('../error/ErrorHooks', () => ({ default: () => ({ handleGlobalError: vi.fn(), clearError: vi.fn() }) }));
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+afterEach(() => { vi.restoreAllMocks(); vi.unstubAllGlobals(); });
+
+test('mounted project page follows server capability and leaves ordinary matrix controls usable', async () => {
+  const section = { _id: 'section-1', sectionTitle: 'Fixture', sectionURL: 'https://dev.libretexts.org/Sandboxes/johnnyphung/test', wcagReview: { criteria: [], summary: {} } };
+  const project = { projectID: 'fixture01', title: 'Fixture project', members: ['editor'], leads: [], liaisons: [], auditors: [], tags: [] };
+  axios.get.mockImplementation(async path => ({ data: path === '/project' ? { err: false, project }
+    : path.includes('remedy/health') ? { err: false, available: false, state: 'disabled', message: 'Remedy is not enabled for this project organization.' }
+    : { err: false, a11yReview: [section] } }));
+  const external = vi.fn(); vi.stubGlobal('fetch', external);
+  const container = document.createElement('div'); document.body.appendChild(container); const root = createRoot(container);
+  try {
+    await act(async () => root.render(<MemoryRouter><ProjectAccessibility match={{ params: { id: 'fixture01' } }} location={{ search: '' }} /></MemoryRouter>));
+    await act(async () => {});
+    expect(container.textContent).toContain('Remedy is not enabled for this project organization.');
+    expect([...container.querySelectorAll('button')].find(b => b.textContent.includes('Scan with Remedy'))).toBeDisabled();
+    expect(container.querySelector('#access-add-section-btn')).not.toBeDisabled();
+    expect(container.querySelector('.remediation-work-queue')).toBeNull();
+    expect(external).not.toHaveBeenCalled();
+    expect(axios.get).toHaveBeenCalledWith('/project/accessibility/remedy/health', { params: { projectID: 'fixture01' } });
+  } finally { await act(async () => root.unmount()); container.remove(); }
+});
