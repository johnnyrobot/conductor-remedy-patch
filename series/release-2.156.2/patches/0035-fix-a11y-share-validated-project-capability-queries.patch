diff --git a/client/src/components/projects/useProjectRemedyCapability.ts b/client/src/components/projects/useProjectRemedyCapability.ts
new file mode 100644
index 00000000..fbabb574
--- /dev/null
+++ b/client/src/components/projects/useProjectRemedyCapability.ts
@@ -0,0 +1,35 @@
+import { useEffect, useRef } from 'react';
+import { useQuery } from '@tanstack/react-query';
+import api, { ProjectRemedyCapability } from '../../api';
+
+const unavailable: ProjectRemedyCapability = {
+  err: false, available: false, readRetry: false,
+  capabilities: { scan: false, preview: false, mutate: false, operation_status: false },
+  message: 'Remedy availability could not be checked. Contact your deployment operator.',
+};
+const checking: ProjectRemedyCapability = { ...unavailable, message: 'Checking Remedy availability.' };
+
+/** One project-scoped read model for the matrix and standalone entry. */
+export default function useProjectRemedyCapability(projectID: string, enabled = true) {
+  const current = useRef({ projectID, enabled });
+  current.current = { projectID, enabled };
+  const mounted = useRef(true);
+  useEffect(() => { mounted.current = true; return () => { mounted.current = false; }; }, []);
+  const query = useQuery<ProjectRemedyCapability>({
+    queryKey: ['remedy-capability', projectID],
+    queryFn: async ({ signal }) => (await api.getProjectRemedyCapability(projectID, signal)).data,
+    enabled: enabled && !!projectID,
+    staleTime: 30_000, retry: false, keepPreviousData: false,
+    refetchOnWindowFocus: false, refetchOnReconnect: false,
+  });
+  const capability = !enabled ? checking : query.isError ? unavailable : query.data || checking;
+  async function refresh() {
+    if (!enabled || !projectID) throw Error(unavailable.message);
+    const result = await query.refetch({ throwOnError: true });
+    if (!mounted.current || current.current.projectID !== projectID || !current.current.enabled || !result.data) {
+      throw Error('The project changed. Check Remedy availability for the current project.');
+    }
+    return result.data;
+  }
+  return { capability, refresh };
+}
