+
+test('standalone ignores a late capability response after switching projects', async () => {
+  let finishOld!: (value: unknown) => void;
+  const oldResponse = new Promise(resolve => { finishOld = resolve; });
+  const { requests, healthCalls, switchProject } = await mount((id: string) => id === 'old-standalone' ? oldResponse : { err: false, available: false, capabilities: noActions }, 'old-standalone');
