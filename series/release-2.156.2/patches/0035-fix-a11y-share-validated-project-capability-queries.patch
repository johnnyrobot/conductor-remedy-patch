+function parseProjectRemedyCapability(data: unknown): ProjectRemedyCapability {
+  const invalid = () => Error('Remedy capability information is unavailable or incompatible.');
+  const record = (value: unknown): value is Record<string, unknown> => !!value && typeof value === 'object' && !Array.isArray(value);
+  const names = ['scan', 'preview', 'mutate', 'operation_status'] as const;
+  if (!record(data) || data.err !== false || typeof data.available !== 'boolean'
+      || (data.readRetry !== undefined && typeof data.readRetry !== 'boolean')) throw invalid();
+  const rawCapabilities = data.capabilities;
+  if (!record(rawCapabilities) || names.some(name => typeof rawCapabilities[name] !== 'boolean')) throw invalid();
+  const capabilities = Object.fromEntries(names.map(name => [name, rawCapabilities[name]])) as RemedyCapabilities;
+  const rawProfile = data.profile;
+  const reviewOnly = record(rawProfile) && rawProfile.name === 'review-only';
+  const required: (keyof RemedyCapabilities)[] = reviewOnly ? ['scan', 'preview'] : [...names];
+  const reasons = ['cxone_configuration_invalid', 'owned_work_unavailable', 'read_dependency_unavailable', 'preview_capacity_unavailable', 'capabilities_unavailable'];
+  let profile: RemedyProfile | undefined;
+  if (rawProfile !== undefined) {
+    if (!record(rawProfile) || rawProfile.contract !== 'cxone-review-v1'
+        || (rawProfile.name !== 'review-only' && rawProfile.name !== 'full-write')
+        || JSON.stringify(rawProfile.required_capabilities) !== JSON.stringify(required)
+        || !Array.isArray(rawProfile.unavailable_reasons) || rawProfile.unavailable_reasons.length > reasons.length
+        || rawProfile.unavailable_reasons.some((reason: unknown) => typeof reason !== 'string' || !reasons.includes(reason))) throw invalid();
+    profile = { contract: 'cxone-review-v1', name: rawProfile.name, required_capabilities: required,
+      unavailable_reasons: [...rawProfile.unavailable_reasons] as string[] };
+  }
+  if ((reviewOnly && capabilities.mutate)
+      || (data.available && required.some(name => !capabilities[name]))
+      || (data.readRetry === true && (data.available || !profile || !reviewOnly
+          || JSON.stringify(profile.unavailable_reasons) !== JSON.stringify(['read_dependency_unavailable'])))) throw invalid();
+  return { err: false, available: data.available, readRetry: data.readRetry === true, capabilities,
+    message: typeof data.message === 'string' && data.message ? data.message : 'Remedy is unavailable for this project.',
+    ...(profile ? { profile } : {}) };
+}
