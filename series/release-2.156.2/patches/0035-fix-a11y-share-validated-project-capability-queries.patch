+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { MemoryRouter } from 'react-router-dom';
+import { afterEach, expect, test, vi } from 'vitest';
+import { screen, waitFor, fireEvent } from '@testing-library/react';
+import axios from 'axios';
+import ProjectAccessibility from './ProjectAccessibility';
+vi.mock('axios', () => ({ default: { get: vi.fn(), post: vi.fn(), put: vi.fn() } }));
+vi.mock('react-redux', () => ({ useSelector: () => ({ uuid: 'editor', roles: [] }) }));
+vi.mock('../error/ErrorHooks', () => ({ default: () => ({ handleGlobalError: vi.fn(), clearError: vi.fn() }) }));
+globalThis.IS_REACT_ACT_ENVIRONMENT = true;
+Object.defineProperty(HTMLElement.prototype, 'scrollIntoView', { configurable: true, value: vi.fn() });
+let root, container, queryClient;
+afterEach(async () => {
+  if (root) await act(async () => root.unmount());
+  container?.remove(); queryClient?.clear(); vi.unstubAllGlobals(); vi.clearAllMocks();
+});
+async function mount(capabilityForProject, initialID = 'capability01') {
+  const capability = id => typeof capabilityForProject === 'function' ? capabilityForProject(id) : capabilityForProject;
+  const healthCalls = [];
+  axios.get.mockImplementation(async (path, options) => {
+    const id = options?.params?.projectID || initialID;
+    if (path.includes('remedy/health')) { healthCalls.push(id); return { data: await capability(id) }; }
+    return { data: path === '/project' ? { err: false, project: { projectID: id, title: id, members: ['editor'], leads: [], liaisons: [], auditors: [], tags: [] } } : { err: false, a11yReview: [{ _id: 'section1', sectionTitle: 'Stored article', sectionURL: 'https://dev.libretexts.org/Sandboxes/johnnyphung/test', pageID: '123', wcagReview: { criteria: [], summary: {} } }] } };
+  });
+  const requests = vi.fn(async (url) => {
+    if (String(url).includes('remedy/health')) {
+      const id = new URL(String(url), 'https://fixture.invalid').searchParams.get('projectID');
+      healthCalls.push(id); return { ok: true, json: async () => await capability(id) };
+    }
+    if (String(url).includes('/operations/')) return { ok: true, json: async () => ({ err: false, pending: true, operation: { outcome: 'known_success' } }) };
+    return { ok: true, json: async () => String(url).endsWith('/conformance')
+      ? { err: false, canEdit: true, report: { scope: null, pages: [], totalCriteria: 0, verifiedCriteria: 0, verificationPercent: 0, status: 'verification_pending', readyForSignoff: false } }
+      : { err: false, canEdit: true, items: [], users: [], candidates: [], sections: [{ id: 'held-page', title: 'Held article', pendingOperationID: 'held-operation' }] } };
+  });
+  vi.stubGlobal('fetch', requests);
+  queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+  container = document.createElement('div'); document.body.appendChild(container); root = createRoot(container);
+  const render = async id => {
+    await act(async () => root.render(<QueryClientProvider client={queryClient}><MemoryRouter><ProjectAccessibility match={{ params: { id } }} location={{ search: '' }} /></MemoryRouter></QueryClientProvider>));
+    await waitFor(() => expect(healthCalls).toContain(id));
+    await act(async () => new Promise(resolve => setTimeout(resolve, 40)));
+  };
+  await render(initialID);
+  return { requests, healthCalls, render };
+}
+test('mounted matrix refuses an incompatible profile instead of enabling scan or recovery', async () => {
+  const { requests } = await mount({ err: false, available: true,
+    capabilities: { scan: true, preview: true, mutate: true, operation_status: true },
+    profile: { contract: 'unknown-profile', name: 'full-write', required_capabilities: ['scan', 'preview', 'mutate', 'operation_status'], unavailable_reasons: [] } });
+  expect(screen.getByRole('button', { name: 'Scan with Remedy' })).toBeDisabled();
+  expect(screen.queryByRole('button', { name: 'Read operation evidence' })).toBeNull();
+  expect(requests.mock.calls.some(([url]) => String(url).includes('/workqueue'))).toBe(false);
+  expect(axios.post).not.toHaveBeenCalled();
+});
+
+
+const noActions = { scan: false, preview: false, mutate: false, operation_status: false };
+const reviewProfile = reasons => ({ contract: 'cxone-review-v1', name: 'review-only', required_capabilities: ['scan', 'preview'], unavailable_reasons: reasons });
+for (const mode of ['signer', 'preview-capacity']) for (const status of [true, false]) {
+  test(`mounted matrix keeps only independent status for ${mode}, status=${status}`, async () => {
+    const response = { err: false, available: false, capabilities: { scan: true, preview: mode === 'signer', mutate: false, operation_status: status },
+      ...(mode === 'preview-capacity' ? { profile: reviewProfile(['preview_capacity_unavailable']) } : {}) };
+    const { requests, healthCalls } = await mount(response);
+    expect(screen.getByRole('button', { name: 'Scan with Remedy' })).toBeDisabled();
+    expect(screen.queryByLabelText('Page tools')).toBeNull();
+    expect(screen.queryByRole('button', { name: 'Rescan page' })).toBeNull();
+    expect(screen.queryByRole('button', { name: 'Apply to LibreTexts' })).toBeNull();
+    expect(container.querySelector('.conformance-review')).toBeNull();
+    expect(requests.mock.calls.some(([url]) => String(url).includes('/operations/'))).toBe(false);
+    if (status) {
+      const read = await screen.findByRole('button', { name: 'Read operation evidence' });
+      await act(async () => fireEvent.click(read));
+      await screen.findByText(/Write confirmed.*page remains blocked/);
+      expect(requests.mock.calls.filter(([url]) => String(url).includes('/operations/'))).toHaveLength(1);
+    } else {
+      expect(screen.queryByRole('button', { name: 'Read operation evidence' })).toBeNull();
+      expect(requests.mock.calls.some(([url]) => String(url).includes('/workqueue'))).toBe(false);
+    }
+    await act(async () => { window.dispatchEvent(new Event('focus')); window.dispatchEvent(new Event('online')); await new Promise(resolve => setTimeout(resolve, 40)); });
+    expect(healthCalls).toHaveLength(1);
+    expect(requests.mock.calls.every(([, init]) => !init?.method || init.method === 'GET')).toBe(true);
+    expect(axios.post).not.toHaveBeenCalled();
+  });
+}
+
+for (const malformed of [
+  { err: false, available: 'yes', capabilities: { ...noActions, operation_status: true } },
+  { err: false, available: true, capabilities: { ...noActions, scan: 'true', preview: true } },
+  { err: false, available: false, readRetry: true, profile: reviewProfile(['preview_capacity_unavailable']), capabilities: { ...noActions, operation_status: true } },
+]) test(`mounted matrix fails closed on malformed response ${JSON.stringify(malformed)}`, async () => {
+  const { requests } = await mount(malformed);
+  expect(screen.getByRole('button', { name: 'Scan with Remedy' })).toBeDisabled();
+  expect(screen.queryByRole('button', { name: 'Read operation evidence' })).toBeNull();
+  expect(requests.mock.calls.some(([url]) => String(url).includes('/workqueue'))).toBe(false);
+  expect(axios.post).not.toHaveBeenCalled();
+});
+
+test('mounted matrix ignores a late capability result after switching projects', async () => {
+  let finishOld;
+  const oldResponse = new Promise(resolve => { finishOld = resolve; });
+  const { render, requests, healthCalls } = await mount(id => id === 'old-project' ? oldResponse : { err: false, available: false, capabilities: noActions }, 'old-project');
+  await render('new-project');
+  await act(async () => finishOld({ err: false, available: true, capabilities: { scan: true, preview: true, mutate: true, operation_status: true } }));
+  await act(async () => new Promise(resolve => setTimeout(resolve, 40)));
+  expect(healthCalls).toEqual(['old-project', 'new-project']);
+  expect(screen.getByRole('button', { name: 'Scan with Remedy' })).toBeDisabled();
+  expect(screen.queryByRole('button', { name: 'Read operation evidence' })).toBeNull();
+  expect(requests.mock.calls.some(([url]) => String(url).includes('/workqueue'))).toBe(false);
+  expect(axios.post).not.toHaveBeenCalled();
+});
+
+test('mounted matrix hides cached recovery while the next project health is pending', async () => {
+  let finishNext;
+  const nextResponse = new Promise(resolve => { finishNext = resolve; });
+  const { render, requests } = await mount(id => id === 'cached-project'
+    ? { err: false, available: false, capabilities: { ...noActions, operation_status: true } } : nextResponse, 'cached-project');
+  await screen.findByRole('button', { name: 'Read operation evidence' });
+  await render('pending-project');
+  expect(screen.queryByRole('button', { name: 'Read operation evidence' })).toBeNull();
+  expect(requests.mock.calls.some(([url]) => String(url).includes('/project/pending-project/'))).toBe(false);
+  await act(async () => finishNext({ err: false, available: false, capabilities: noActions }));
+  await act(async () => new Promise(resolve => setTimeout(resolve, 40)));
+  expect(screen.getByRole('button', { name: 'Scan with Remedy' })).toBeDisabled();
+  expect(screen.queryByRole('button', { name: 'Read operation evidence' })).toBeNull();
+});
