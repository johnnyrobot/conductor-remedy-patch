From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: johnnyrobot <174211481+johnnyrobot@users.noreply.github.com>
Date: Thu, 29 Oct 2026 10:45:45 -0700
Subject: [PATCH] build: pin the existing Node22 Linux recipe to an immutable
 base (LT-158)

---
 Dockerfile | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/Dockerfile b/Dockerfile
index eebd0676..5f4b8458 100644
--- a/Dockerfile
+++ b/Dockerfile
@@ -1,5 +1,8 @@
+# Immutable candidate base; validate a new digest before changing it.
+ARG CONDUCTOR_NODE_IMAGE=node:22-alpine3.22@sha256:cd7807368cf24826297cbad5dca1a44972ccfd770647db52a8c7589eb4599ac8
+
 # Stage 1: Build client
-FROM node:22-alpine3.22 AS client-builder
+FROM ${CONDUCTOR_NODE_IMAGE} AS client-builder
 WORKDIR /usr/src/conductor/client
 
 # Install git (needed for git dependencies in package.json)
@@ -20,7 +23,7 @@ COPY client/ ./
 RUN npm run build
 
 # Stage 2: Build server
-FROM node:22-alpine3.22 AS server-builder
+FROM ${CONDUCTOR_NODE_IMAGE} AS server-builder
 WORKDIR /usr/src/conductor/server
 
 # Copy manifest + lockfile and install the exact, committed tree (see client note)
@@ -35,7 +38,7 @@ RUN mkdir -p ./public
 RUN npm run build
 
 # Stage 3: Production runtime
-FROM node:22-alpine3.22
+FROM ${CONDUCTOR_NODE_IMAGE}
 
 # Build arguments for dynamic labels
 ARG VERSION=dev
-- 
2.54.0 (Apple Git-157)

