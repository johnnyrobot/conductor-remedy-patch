@@ -0,0 +1,32 @@
+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { expect, test } from 'vitest';
+import { ApplyResultPanel } from './ProjectAccessibility';
+
+(globalThis).IS_REACT_ACT_ENVIRONMENT = true;
+
+test('matrix apply reports an empty write without claiming success', async () => {
+    const container = document.createElement('div');
+    document.body.appendChild(container);
+    const root = createRoot(container);
+
+    try {
+        await act(async () => root.render(
+            <ApplyResultPanel applyResult={{
+                applied: false,
+                attempted_rule_ids: ['duplicate-id'],
+                applied_rule_ids: [],
+            }} />,
+        ));
+
+        expect(container.textContent).toContain(
+            'No changes were written: the preview contained no content change.',
+        );
+        expect(container.textContent).not.toContain('Apply complete');
+        expect(container.textContent).not.toContain('Remedy wrote the selected changes');
+        expect(container.querySelector('.ui.green.segment')).toBeNull();
+    } finally {
+        await act(async () => root.unmount());
+        container.remove();
+    }
+});
